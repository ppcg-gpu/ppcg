  @@ -256,6 +256,52 @@ license_add_file("llama.cpp" "LICENSE")
  +# A whole-program engine.
  +#
  +# LLAMA_WHOLE_PROGRAM_LIB names one shared library holding every unit of
  +# the engine, made by linking their ASTs together and generating one
  +# module out of the result -- see ~/forge/ppcg, tests/whole-program.
  +# Given one, the engine is not compiled here at all: the four targets a
  +# build usually makes are declared as that one library instead, so that
  +# everything downstream links it and nothing else changes.
  +#
  +# What it is for is checking that the whole-program path kept the
  +# program.  Its own account of itself -- every call resolved, nothing
  +# refused -- is made from the same reading that produced the module, so
  +# it cannot notice what the reading dropped.  The project's own tests
  +# can: they were written against the engine and do not know where it
  +# came from.
  +#
  +# The drafter's library is still compiled from source.  It is the same
  +# engine again with another model and a prefix on its symbols, so a
  +# whole-program build of it is a second library and a second question.
  +if (LLAMA_WHOLE_PROGRAM_LIB)
  +    if (NOT EXISTS "${LLAMA_WHOLE_PROGRAM_LIB}")
  +        message(FATAL_ERROR
  +            "LLAMA_WHOLE_PROGRAM_LIB names ${LLAMA_WHOLE_PROGRAM_LIB}, "
  +            "which is not there")
  +    endif()
  +    message(STATUS
  +        "Engine taken whole from ${LLAMA_WHOLE_PROGRAM_LIB}")
  +
  +    add_library(llama SHARED IMPORTED GLOBAL)
  +    set_target_properties(llama PROPERTIES
  +        IMPORTED_LOCATION "${LLAMA_WHOLE_PROGRAM_LIB}"
  +        IMPORTED_NO_SONAME TRUE
  +        INTERFACE_INCLUDE_DIRECTORIES
  +            "${CMAKE_CURRENT_SOURCE_DIR}/engine/include;${CMAKE_CURRENT_SOURCE_DIR}/engine/ggml/include"
  +        INTERFACE_COMPILE_DEFINITIONS "LLAMA_SHARED;GGML_SHARED")
  +
  +    # The three ggml targets name the same library: one module holds what
  +    # all of them held, and a caller that asks for any of them is asking
  +    # for what is in there.
  +    foreach(part ggml ggml-base ggml-cpu)
  +        add_library(${part} INTERFACE IMPORTED GLOBAL)
  +        set_target_properties(${part} PROPERTIES
  +            INTERFACE_LINK_LIBRARIES llama)
  +    endforeach()
  +endif()
  +
   if (LLAMA_USE_SYSTEM_GGML)
       message(STATUS "Using system-provided libggml, skipping ggml build")
       find_package(ggml REQUIRED)
